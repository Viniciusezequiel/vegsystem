# Variáveis de ambiente do frontend (Vite).
# Cadastre estas variáveis na Vercel (Production, Preview e Development).
# Todas são públicas por natureza — a proteção dos dados é feita por RLS.
# NUNCA cadastre service_role, senha do banco ou secrets administrativos aqui.

VITE_SUPABASE_URL="https://sshyjnyvihdheofjzsca.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/publishable key do projeto sshyjnyvihdheofjzsca>"
VITE_SUPABASE_PROJECT_ID="sshyjnyvihdheofjzsca"

# Endpoint público do Worker usado para locators r2/lost-items/*.
# Isoladamente esta variável NÃO habilita uploads R2.
VITE_STORAGE_WORKER_URL="https://vegsystem-storage.viniciusezequiel.workers.dev"

# Chave futura de escrita: somente o valor exato "true" habilita novos uploads R2.
# Ausente, "false" ou qualquer outro valor mantém as escritas no Supabase.
VITE_R2_NEW_UPLOADS_ENABLED="false"
